(function () {
  var params = new URLSearchParams(location.search);
  if (!params.has("ref")) return;

  var ref = (params.get("ref") || "").trim();
  var valid = /^[A-Za-z0-9._-]{1,64}$/.test(ref);

  if (valid) {
    var host = location.hostname;
    var domain = host === "ragedevert.ch" || host.slice(-14) === ".ragedevert.ch"
      ? "; Domain=.ragedevert.ch"
      : "";
    var secure = location.protocol === "https:" ? "; Secure" : "";

    document.cookie = "ref=" + encodeURIComponent(ref)
      + "; Path=/; Max-Age=<%= referral_cookie_max_age %>; SameSite=Lax"
      + domain
      + secure;
  }

  params.delete("ref");
  var search = params.toString();
  history.replaceState(null, "", location.pathname + (search ? "?" + search : "") + location.hash);

  <% if umami_enabled? %>
    if (!valid) return;

    window.trackReferral = function () {
      if (!window.umami) return;

      window.umami.identify({ ref: ref });
      window.umami.track("referral", { ref: ref });
    };
  <% end %>
})();
